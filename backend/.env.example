# =============================================================================
#  QuickInsights backend configuration
#  Copy this file to ".env" and fill in your real values:
#      cp .env.example .env
#  Do NOT commit your real .env to git.
#
#  NOTE: per-database credentials (host/user/password/db name) are NOT set
#  here — they are entered through the app's Connections page and stored per
#  DatabaseConnection record, since this backend can talk to multiple
#  different databases at once.
# =============================================================================

# ── LLM provider ─────────────────────────────────────────────────────────────
# One-time seed only — after the backend has started once, these (and the API
# keys/SMTP settings below) live in the metadata database and are edited from
# Admin -> Setup in the app itself, not here. Changing these values in .env
# after that point has no effect; use the Setup page instead.
# "openai" or "anthropic"
LLM_PROVIDER=openai

# ── API keys ──────────────────────────────────────────────────────────────────
# Required when EMBED_PROVIDER=openai OR LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-claude-key

OPENAI_CHAT_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-sonnet-4-6

# ── Embedding provider ────────────────────────────────────────────────────────
# "openai"                -> uses OpenAI text-embedding-3-small (needs OPENAI_API_KEY)
# "sentence-transformers" -> runs fully local, no API key, no cost
EMBED_PROVIDER=openai
ST_EMBED_MODEL=all-MiniLM-L6-v2
# Hugging Face token — free, only needed once to download sentence-transformers models faster.
HF_TOKEN=hf_your_token_here

# Vector dimension — must match the active embedding model.
# openai text-embedding-3-small = 1536 | all-MiniLM-L6-v2 = 384 | all-mpnet-base-v2 = 768
# Leave blank to let the code pick the right default automatically.
EMBED_DIM=

# ── Qdrant vector database (Docker) ──────────────────────────────────────────
# Start with: docker compose up -d
# Leave blank to fall back to embedded on-disk mode (no Docker needed).
QDRANT_URL=http://localhost:6333
over
# ── App metadata database (MariaDB, Docker) ──────────────────────────────────
# Persists connections/reports/schedules/SQL examples/training state across
# backend restarts. Start with: docker compose up -d (starts this alongside
# Qdrant). Same version Frappe recommends (10.6 LTS) — separate database from
# whatever you connect to via the Connections page.
METADATA_DB_HOST=localhost
METADATA_DB_PORT=3307
METADATA_DB_NAME=quickinsights
METADATA_DB_USER=quickinsights
METADATA_DB_PASSWORD=quickinsights
# Root password for the mariadb container itself (docker-compose.yml only).
METADATA_DB_ROOT_PASSWORD=quickinsights_root
# Set this instead of the METADATA_DB_* pieces above to point at an existing
# MariaDB/MySQL server (e.g. mysql+pymysql://user:pass@host:3306/dbname).
METADATA_DATABASE_URL=

# Encrypts saved DatabaseConnection passwords at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank only for local/throwaway dev.
ENCRYPTION_KEY=

# ── Token / retrieval controls ────────────────────────────────────────────────
TOP_K_SCHEMA=3
TOP_K_EXAMPLES=2
MAX_RESULT_ROWS=200
AUTO_LIMIT=500
SAMPLE_ROWS_FOR_LLM=3
ENABLE_FOLLOWUPS=true

# ── Optional: limit training scope ───────────────────────────────────────────
# Comma-separated DocType names. Leave blank to train on ALL tab* tables.
# Recommended on large ERPNext sites to keep embedding cost low.
# Example: DOCTYPE_FILTER=Sales Order,Sales Invoice,Customer,Item
DOCTYPE_FILTER=

# ── Optional: SMTP for scheduled report emails ───────────────────────────────
# One-time seed only, same as the LLM/embedding settings above — edit these
# from Admin -> Setup after first startup, not here. Leave SMTP_HOST blank to
# skip sending email (scheduled runs still execute and record history, they
# just won't deliver anything).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
